filters:
  and:
    - file.ext == "md"
    - type == "person"
    - '!file.inFolder("_system/templates")'
    - '!file.inFolder("99-Archive")'
formulas:
  days_since: 'if(last_interaction, (today() - date(last_interaction)).days, "")'
  follow_up_due: 'if(follow_up_date, date(follow_up_date) <= today(), false)'
properties:
  relationship:
    displayName: Холбоо
  role:
    displayName: Үүрэг
  companies:
    displayName: Байгууллага
  projects:
    displayName: Төсөл
  last_interaction:
    displayName: Сүүлд харилцсан
  follow_up_date:
    displayName: Дахин холбогдох
  hot:
    displayName: Hot
  formula.days_since:
    displayName: Хоног өнгөрсөн
  formula.follow_up_due:
    displayName: Холбогдох цаг
views:
  - type: table
    name: Бүгд
    groupBy:
      property: relationship
      direction: ASC
    order:
      - file.basename
      - role
      - companies
      - projects
      - last_interaction
  - type: table
    name: Холбогдох
    filters:
      and:
        - follow_up_date
        - formula.follow_up_due == true
    order:
      - file.basename
      - follow_up_date
      - relationship
      - companies
  - type: table
    name: Hot
    filters:
      and:
        - hot == true
    order:
      - file.basename
      - last_interaction
      - formula.days_since
      - relationship
      - companies
      - projects
  - type: table
    name: Баг
    filters:
      and:
        - relationship == "team"
    order:
      - file.basename
      - role
      - companies
      - projects
  - type: cards
    name: Картууд
    order:
      - file.basename
      - relationship
      - role
