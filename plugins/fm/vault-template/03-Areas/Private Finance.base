filters:
  and:
    - type == "bill"
views:
  - type: table
    name: Сарын төлбөр
    order:
      - file.name
      - category
      - amount
      - due_day
      - status
      - last_paid
    sort:
      - property: status
        direction: DESC
  - type: table
    name: Хувийн захиалгууд
    filters:
      and:
        - type == "bill" || type == "finance-record"
        - category == "subscription" || kind == "subscription"
        - file.inFolder("03-Areas/Business/finances/private")
    order:
      - file.name
      - amount
      - due_day
      - valid-until
      - status
    summaries:
      amount: Sum
