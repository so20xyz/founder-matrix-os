filters:
  and:
  - file.inFolder("04-Resources/Topics")
  - type == "topic"
views:
- type: table
  name: Сэдвүүд
  order:
  - file.name
  - file.backlinks
  sort:
  - property: file.name
    direction: ASC
- type: table
  name: 🧭 INAI сэдэв ба асуулт
  filters:
    and:
    - '!file.inFolder("_trash")'
    - '!file.inFolder("_system")'
    - '!file.inFolder("03-Areas/Business/finances")'
    - file.inFolder("04-Resources/Topics")
    - type == "topic"
    - scope == "inai"
  order:
  - file.basename
  - open-questions
