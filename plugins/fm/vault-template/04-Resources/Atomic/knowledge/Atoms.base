filters:
  and:
    - file.ext == "md"
    - file.inFolder("04-Resources/Atomic")
    - '!file.inFolder("_system/templates")'
formulas:
  kind: 'if(type == "session-decision", "🔑 шийдвэр", if(type == "atomic", "🧩 мэдлэг", "❔ " + type))'
  has_home: 'if((projects && projects.length > 0) || (areas && areas.length > 0), "✅", "🔴")'
  age_days: '(now() - file.ctime).days'
properties:
  formula.kind:
    displayName: Төрөл
  formula.has_home:
    displayName: PARA гэр
  formula.age_days:
    displayName: Нас (хоног)
  confidence:
    displayName: Итгэлцэл
views:
  - type: table
    name: Сүүлийн атомууд
    limit: 50
    order:
      - date
      - file.basename
      - formula.kind
      - confidence
      - formula.has_home
  - type: table
    name: Мэдлэг
    filters:
      and:
        - type == "atomic"
    groupBy:
      property: confidence
      direction: ASC
    order:
      - file.basename
      - date
      - projects
      - areas
  - type: table
    name: ⚠️ PARA гэргүй
    filters:
      and:
        - '!projects || projects.length == 0'
        - '!areas || areas.length == 0'
    order:
      - file.basename
      - formula.kind
      - date
  - type: table
    name: ⚠️ Буруу төрөл
    filters:
      and:
        - type != "atomic"
        - type != "session-decision"
    order:
      - file.basename
      - type
      - file.folder
