filters:
  and:
    - '!file.inFolder("_system/templates")'
    - '!file.inFolder("_trash")'
    - file.ext == "md"
    - file.inFolder("04-Resources/Atomic/decisions")
properties:
  decision:
    displayName: Шийдвэр
  changetype:
    displayName: Төрөл
  status:
    displayName: Төлөв
  decidedby:
    displayName: Хэн
  date:
    displayName: Огноо
  projects:
    displayName: Төсөл
  tags:
    displayName: Tags
views:
  - type: table
    name: By Change-Type
    groupBy:
      property: changetype
      direction: ASC
    order:
      - decision
      - status
      - decidedby
      - date
    sort: []
    columnSize:
      decision: 420
      status: 100
      decidedby: 70
      date: 110
  - type: calendar
    name: Calendar
  - type: table
    name: Live Only
    filters:
      and:
        - status == "accepted"
    order:
      - date
      - changetype
      - decision
    direction: DESC
    columnSize:
      decision: 440
  - type: table
    name: Pivotal
    filters:
      or:
        - changetype == "decision"
        - changetype == "structure"
        - changetype == "skill"
        - changetype == "schema"
        - changetype == "tool"
    order:
      - date
      - changetype
      - decision
      - status
    direction: DESC
    columnSize:
      decision: 420
  - type: table
    name: 🌉 Гүүр шийдвэрүүд
    filters:
      and:
        - bridge >= 3
    order:
      - file.name
      - bridge
      - projects
      - from
    sort:
      - property: bridge
        direction: DESC
