filters:
  and:
    - note.type == "reference"
    - '!file.inFolder("_system/templates")'
    - '!file.inFolder("_trash")'
    - file.ext == "md"
properties:
  cover:
    displayName: Cover
  reftype:
    displayName: Төрөл
  platform:
    displayName: Платформ
  status:
    displayName: Төлөв
  tags:
    displayName: Шошго
  url:
    displayName: Холбоос
  created:
    displayName: Хадгалсан
  favorite:
    displayName: ★
views:
  - type: cards
    name: All
    groupBy:
      property: reftype
      direction: ASC
    order:
      - file.name
      - reftype
      - platform
      - status
      - url
    image: cover
  - type: cards
    name: Product
    filters:
      and:
        - reftype == "Product"
    order:
      - file.name
      - platform
      - tags
    image: cover
  - type: cards
    name: Video
    filters:
      and:
        - reftype == "Video"
    order:
      - file.name
      - created
      - tags
    image: cover
  - type: cards
    name: AI skill
    filters:
      and:
        - reftype == "ai skill"
    order:
      - file.name
      - tags
    image: cover
  - type: cards
    name: My Tools
    filters:
      and:
        - reftype == "My Tools"
    order:
      - file.name
      - tags
    image: cover
  - type: cards
    name: Template
    filters:
      and:
        - reftype == "Template"
    order:
      - file.name
      - tags
    image: cover
  - type: cards
    name: Website
    filters:
      and:
        - reftype == "Website"
    order:
      - file.name
      - tags
    image: cover
  - type: cards
    name: Reading
    filters:
      or:
        - reftype == "Post"
        - reftype == "Article"
        - reftype == "Book"
    order:
      - file.name
      - reftype
    image: cover
  - type: cards
    name: Visual
    filters:
      or:
        - reftype == "Moodboard"
        - reftype == "Infographic"
        - reftype == "website inspire"
    order:
      - file.name
      - reftype
    image: cover
  - type: cards
    name: Working
    filters:
      or:
        - reftype == "design-input"
        - reftype == "design-spec"
        - reftype == "idea-set"
    order:
      - file.name
      - reftype
    image: cover
  - type: cards
    name: Research
    filters:
      and:
        - reftype == "Research"
    order:
      - file.name
      - reftype
    image: cover
  - type: cards
    name: Other
    filters:
      and:
        - reftype != "Product"
        - reftype != "Video"
        - reftype != "ai skill"
        - reftype != "My Tools"
        - reftype != "Template"
        - reftype != "Website"
        - reftype != "Post"
        - reftype != "Article"
        - reftype != "Book"
        - reftype != "Moodboard"
        - reftype != "Infographic"
        - reftype != "website inspire"
        - reftype != "design-input"
        - reftype != "design-spec"
        - reftype != "idea-set"
        - reftype != "Research"
    order:
      - file.name
      - reftype
    image: cover
  - type: cards
    name: Favorites
    filters:
      and:
        - favorite == true
    order:
      - file.name
      - reftype
    image: cover
  - type: cards
    name: No cover
    filters:
      and:
        - "!cover"
    order:
      - file.name
      - url
  - type: table
    name: Table
    groupBy:
      property: reftype
      direction: ASC
    order:
      - file.name
      - reftype
      - platform
      - status
      - created
      - url
  - type: table
    name: 🧠 Синапс (хэн ашигласан)
    order:
      - file.name
      - project
      - task
      - file.backlinks
  - type: table
    name: Эх сурвалж (source)
    filters:
      and:
        - type == "source"
    order:
      - file.name
      - claim
      - status
      - source-date
