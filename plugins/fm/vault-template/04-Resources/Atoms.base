filters:
  and:
    - file.inFolder("04-Resources/Atomic/knowledge")
    - file.ext == "md"
views:
  - type: table
    name: Бүгд
    order:
      - file.name
      - date
      - confidence
      - projects
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: Өнөөдөр (бодлын сешн)
    filters:
      and:
        - date == today()
    order:
      - file.name
      - confidence
      - projects
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 356
  - type: table
    name: Төслөөр
    groupBy:
      property: projects
      direction: ASC
    order:
      - file.name
      - date
      - projects
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: 🌉 Гүүр ойлголтууд
    filters:
      and:
        - bridge >= 3
    order:
      - file.name
      - bridge
      - projects
      - from
      - topics
    sort:
      - property: bridge
        direction: DESC
