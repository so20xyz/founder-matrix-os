filters:
  and:
    - file.ext == "md"
    - file.inFolder("04-Resources/library")
    - file.name != "README"
properties:
  author:
    displayName: Зохиогч
  status:
    displayName: Төлөв
views:
  - type: table
    name: Бүгд
    order:
      - file.basename
      - author
      - status
      - date
