# Copy to .env and fill locally. .env is gitignored — never commit real values.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
# Generate: openssl rand -hex 32  (keep the same key when moving PC/Mac → Oracle, or credentials break)
N8N_ENCRYPTION_KEY=
TZ=Asia/Ulaanbaatar
# Public URL for webhooks (cloudflared tunnel or Oracle domain). Local test: leave default.
WEBHOOK_URL=http://localhost:5678/
# Telegram bot token from @BotFather (fill locally)
FMOS_TELEGRAM_TOKEN=
# Discord channel id for Telegram → inbox messages (Developer mode → right-click channel → Copy ID)
FMOS_INBOX_CHANNEL_ID=
